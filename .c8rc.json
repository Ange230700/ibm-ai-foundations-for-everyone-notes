{
  "all": true,
  "include": ["packages/*/src/**/*.ts"],
  "exclude": ["packages/*/test/**/*.ts"],
  "extension": [".ts"],
  "exclude-after-remap": true,
  "reporter": ["text", "lcov", "json-summary"],
  "reports-dir": "coverage",
  "clean": true,
  "check-coverage": true,
  "per-file": true,
  "statements": 100,
  "branches": 100,
  "functions": 100,
  "lines": 100
}
