{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
  },
  "globs": ["**/*.md", "!**/node_modules/**", "!**/.artifacts/**"],
  "overrides": [
    {
      "filter": ["teaching/sessions/*/deliveries/narration/*.md"],
      "config": { "MD041": false },
      "combine": "merge",
    },
  ],
}
